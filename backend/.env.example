# Copy to .env and fill in the real password (from Supabase → Settings → Database).
# .env is git-ignored — the password never gets committed.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Shared API key the frontend sends as X-API-Key. Set a real value before deploying.
API_TOKEN=viasel-dev
